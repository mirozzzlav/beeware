{
  "manifest_version": 3,
  "developer": {
    "name": "Miro Furinda"
  },
  "description": "Krátka pauza pred návštevou vybraných domén. Otvor stránku s jasným zámerom.",
  "permissions": [
    "storage",
    "declarativeNetRequestWithHostAccess",
    "webNavigation"
  ],
  "action": {
    "default_icon": "icon.svg"
  },
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "host_permissions": ["*://*.facebook.com/*"],
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "web_accessible_resources": [
    {
      "resources": ["index.html"],
      "matches": ["<all_urls>"]
    }
  ],
  "optional_host_permissions": ["*://*/*"],
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  }
}
