{
  "manifest_version": 3,
  "name": "Beeware",
  "version": "0.1.0",
  "description": "Krátka pauza pred návštevou vybraných domén. Otvor stránku s jasným zámerom.",
  "permissions": [
    "storage",
    "webRequest",
    "webRequestBlocking",
    "webNavigation"
  ],
  "action": {
    "default_title": "Beeware",
    "default_icon": "icon.svg"
  },
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "@beeware.wondercules",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "host_permissions": ["*://*.facebook.com/*"],
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "web_accessible_resources": [
    {
      "resources": ["index.html"],
      "matches": ["<all_urls>"]
    }
  ],
  "optional_host_permissions": ["*://*/*"],
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  }
}
