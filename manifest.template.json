{
  "manifest_version": 3,
  "author": "Miro Furinda",
  "description": "Krátka pauza pred návštevou vybraných domén. Otvor stránku s jasným zámerom.",
  "permissions": [
    "storage",
    "declarativeNetRequestWithHostAccess",
    "webNavigation"
  ],
  "action": {
    "default_icon": "icon.png"
  },
  "icons": {
    "128": "icon.png"
  },
  "host_permissions": ["*://*.facebook.com/*"],
  "web_accessible_resources": [
    {
      "resources": ["index.html"],
      "matches": ["<all_urls>"]
    }
  ],
  "optional_host_permissions": ["*://*/*"],
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  }
}
